IDI_BUILTIN_SYSTEM_INFORMATION ICON               "..\\assets\\builtin-system-information.ico"
IDI_BUILTIN_REGISTRY_EDITOR    ICON               "..\\assets\\builtin-registry-editor.ico"
IDI_BUILTIN_CALCULATOR         ICON               "..\\assets\\builtin-calculator.ico"
